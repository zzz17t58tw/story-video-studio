# ── 建置產物與環境（不進版控）────────────────────────────────
.venv/
build/
dist/
release/
__pycache__/
*.pyc
*.pyo
*.spec.bak

# ── 使用者資料（絕不進版控）──────────────────────────────────
# 根目錄 projects/ 是開發主資料（10 專案、130MB），內容是實作成果，
# 不放進 git 歷史；備份靠整資料夾複製，不靠 git。
projects/
# app/gpu.py 會把 GPU 設定寫到 ./memory/gpu-settings.json
memory/

# ── 日誌與暫存 ───────────────────────────────────────────────
*.log
.scratch/
# 對話匯出、臨時驗證腳本等一律不進版控
temp/

# ── 文件：docs/ 進 repo（共約 10.4MB，含 docs/shots 截圖與一支對照 mp4），
#    小於門檻，保留可追溯的驗收證據。
#    若日後 docs/ 超過 20MB，改為只留 .md：
#      docs/shots/
#      docs/**/*.mp4

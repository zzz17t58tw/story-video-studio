# ── 建置產物與環境（不進版控）────────────────────────────────
/.venv/
/build/
/dist/
/release/
__pycache__/
*.pyc
*.pyo
*.spec.bak

# ── 使用者資料（絕不進版控）──────────────────────────────────
# 根目錄 projects/ 是開發主資料（10 專案、130MB），內容是實作成果，
# 不放進 git 歷史；備份靠整資料夾複製，不靠 git。
/projects/
# app/gpu.py 會把 GPU 設定寫到 ./memory/gpu-settings.json
/memory/

# ── 日誌與暫存 ───────────────────────────────────────────────
*.log
.scratch/
# 對話匯出、臨時驗證腳本等一律不進版控
temp/

# ── 文件：docs/ 進 repo（共約 10.4MB，含 docs/shots 截圖與一支對照 mp4），
#    小於門檻，保留可追溯的驗收證據。
#    若日後 docs/ 超過 20MB，改為只留 .md：
#      docs/testing/evidence/
#      docs/**/*.mp4

docs/testing/nightly-audit/*.json

# ── 不上傳（2026-11-25 使用者定案）────────────────────────────
# 上傳範圍只有三種：①主程式 ②乾淨壓縮包（Release 附件）③代理人／技能資料。
# 開發與測試、私人資料一律不上傳：本地保留，但不進版控、不 push。
tests/
tools/
docs/testing/
docs/handoff/
PLAN.md
